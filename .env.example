# Zcash testnet RPC connection (only needed if you run a local zcashd/zebra node)
ZCASH_TESTNET_RPC_URL=http://localhost:18232
ZCASH_TESTNET_RPC_USER=
ZCASH_TESTNET_RPC_PASSWORD=

# Optional: encrypt issuance keys and wallet files at rest with AES-256-GCM.
# If unset, files are written in plaintext (a one-time warning is logged).
# Use a strong, unique passphrase. Losing it = losing the keys.
ZCASH_KEY_PASSPHRASE=

# Optional: path to the Rust tx-tool checkout used by the Rust CLI deploy/transfer/burn flow.
# Default: ./tx-tool relative to the project root.
ZCASH_TX_TOOL_DIR=

# Optional: when set to 'false', use mock paths instead of invoking the Rust CLI.
# Default: invoke the Rust CLI when available.
ZSA_USE_CLI=

# Optional: when 'true', request the local node mine the issuance/transfer transaction.
ZSA_MINE=
